SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here
GROQ_API_KEY=your_groq_api_key_here

# Optional — overrides the default chat model set in app/config.py.
# Groq retired llama-3.3-70b-versatile; we default to openai/gpt-oss-120b.
# List what your key can access with: groq_client.models.list()
# GROQ_MODEL=openai/gpt-oss-120b

# Optional — YouTube Data API v3 (free, quota-based; NOT a paid course-
# provider integration; no billing needs to be enabled). Get one at
# https://console.cloud.google.com/apis/credentials — restrict it to
# YouTube Data API v3 and, if your infra supports it, to your backend's
# server IP. Never enable this key for any other API, and never put it
# in frontend code. If unset, the YouTube provider adapter returns no
# results rather than failing the request or fabricating one.
YOUTUBE_API_KEY=
